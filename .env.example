# Care 360
NUXT_PUBLIC_GRAPHQL_LINK_NAME=link name

NUXT_PUBLIC_CARE360_TOKEN=token

NUXT_PUBLIC_GRAPHQL_API_URL=graphql endpoint

# Application Configuration
SMTP_HOST=smtp server address

SMTP_PASS=password

SMTP_PORT=port number

SMTP_SUBJECT=email subject text

SMTP_USER=user email id

# Analytics Configuration
# GTM Configuration (Required for Google Tag Manager integration)
NUXT_PUBLIC_GTM_ID=your_gtm_id

# AWS S3 Configuration (Required for file uploads)
# These credentials should be kept private and never committed to version control
# AWS Region where your S3 bucket is located (e.g., us-east-1, us-west-2)
NUXT_AWS_REGION=your_aws_region

# AWS Access Key ID (from IAM user with S3 permissions)
NUXT_AWS_ACCESS_KEY_ID=your_aws_access_key_id

# AWS Secret Access Key (from IAM user with S3 permissions)
NUXT_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3 Bucket Name for storing uploaded files
NUXT_AWS_S3_BUCKET_NAME=your_s3_bucket_name

# Payment Gateway Configuration
# NMI Payment Gateway Configuration
NUXT_PUBLIC_NMI_COLLECTJS_KEY=your_nmi_collectjs_key

# Project Management Configuration
# Project Name
NUXT_PROJECT_NAME="Your Project Name"

# Project Logo URL
NUXT_PROJECT_LOGO_URL="/images/logo.png"

# Project Domain
NUXT_PROJECT_DOMAIN="yourdomain.com"

# Default Category
NUXT_PUBLIC_DEFAULT_CATEGORY=category name

# Slackbot Configuration
NUXT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Calendly Configuration
NUXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link

# Privacy and policy
NUXT_PUBLIC_PRIVACY_POLICY=https://yourdomain.com/privacy-policy/
