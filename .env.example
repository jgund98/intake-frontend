# AWS Configuration
NUXT_AWS_ACCESS_KEY_ID=your-aws-access-key
NUXT_AWS_REGION=us-east-1
NUXT_AWS_S3_BUCKET_NAME=your-s3-bucket-name
NUXT_AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Project Configuration
NUXT_PROJECT_DOMAIN=https://your-domain.com/
NUXT_PROJECT_LOGO_URL=/images/logo.svg
NUXT_PROJECT_NAME=your-project-name

# Calendly Integration
NUXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link/

# Care360 API Configuration
NUXT_PUBLIC_CARE360_TOKEN=your-care360-token
NUXT_PUBLIC_GRAPHQL_API_URL=https://api.care360-next.carevalidate.com
NUXT_PUBLIC_GRAPHQL_LINK_NAME=your-organization-link-name

# Default Category (must match a category in data/forms/index.ts)
# Options: Weightloss, Skin Care, Sexual Health, Anti-Aging & Peptides, Foot & Nail Health
NUXT_PUBLIC_DEFAULT_CATEGORY=Weightloss

# Google Tag Manager
NUXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# NMI Payment Gateway
NUXT_PUBLIC_NMI_COLLECTJS_KEY=your-nmi-key

# Privacy Policy
NUXT_PUBLIC_PRIVACY_POLICY=https://your-domain.com/legal/privacy-policy

# Slack Webhook (for notifications)
NUXT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PASS=your-smtp-password
SMTP_PORT=587
SMTP_SUBJECT=New Contact Form Submission
SMTP_USER=your-email@example.com
